<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher icon foreground: a blue pickleball paddle seen face-on, handle down.
  Drawn on the 108x108 adaptive-icon canvas; artwork stays inside the central
  66dp safe zone so no launcher mask (circle, squircle, etc.) clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Handle grip -->
    <path
        android:fillColor="#0B3A75"
        android:pathData="M49.5,70 L58.5,70 L58.5,86 A3,3 0 0 1 55.5,89 L52.5,89 A3,3 0 0 1 49.5,86 Z" />

    <!-- Grip wrap -->
    <path
        android:strokeColor="#2563B0"
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M50,74.5 L58,76.5 M50,78.5 L58,80.5 M50,82.5 L58,84.5" />

    <!-- Throat where the handle meets the face -->
    <path
        android:fillColor="#0D47A1"
        android:pathData="M46,66 L62,66 L59,72 L49,72 Z" />

    <!-- Paddle face -->
    <path
        android:fillColor="#1565C0"
        android:pathData="M35,36 A14,14 0 0 1 49,22 L59,22 A14,14 0 0 1 73,36 L73,61 A7,7 0 0 1 66,68 L42,68 A7,7 0 0 1 35,61 Z" />

    <!-- Lighter inner face for a little depth -->
    <path
        android:fillColor="#1E88E5"
        android:pathData="M39.5,37 A10.5,10.5 0 0 1 50,26.5 L58,26.5 A10.5,10.5 0 0 1 68.5,37 L68.5,59 A4.5,4.5 0 0 1 64,63.5 L44,63.5 A4.5,4.5 0 0 1 39.5,59 Z" />

    <!-- Edge guard -->
    <path
        android:strokeColor="#0D47A1"
        android:strokeWidth="2"
        android:strokeLineJoin="round"
        android:pathData="M35,36 A14,14 0 0 1 49,22 L59,22 A14,14 0 0 1 73,36 L73,61 A7,7 0 0 1 66,68 L42,68 A7,7 0 0 1 35,61 Z" />
</vector>
